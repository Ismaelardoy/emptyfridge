# Copia este fichero a .env y ajusta los valores.
# Docker Compose lo lee automáticamente para `docker compose up`.

# --- Base de datos ---------------------------------------------------------
POSTGRES_DB=emptyfridge
POSTGRES_USER=emptyfridge
# Usa una contraseña URL-safe, por ejemplo: openssl rand -hex 24
POSTGRES_PASSWORD=emptyfridge
POSTGRES_PORT=5432
# Solo para ejecutar la API fuera de Docker (pnpm dev).
# Si cambias POSTGRES_USER/PASSWORD/DB/PORT, actualiza también esta URL.
DATABASE_URL=postgres://emptyfridge:emptyfridge@localhost:5432/emptyfridge
# En local no hay TLS; en Supabase/Render pon require.
DATABASE_SSL=disable
# Pon false solo si usas el pooler de transacciones de Supabase (puerto 6543).
DATABASE_PREPARE=true
# Solo para plataformas sin paso de migraciones (Render free, Railway, Fly):
# RUN_MIGRATIONS=true y una sola instancia. En Compose lo hace el servicio `migrate`.
# RUN_MIGRATIONS=false

# --- Aplicación ------------------------------------------------------------
APP_PORT=8080
# URL pública real. Si empieza por https:// las cookies se marcan Secure.
PUBLIC_URL=http://localhost:8080

# --- Proxy opcional (perfil `proxy`) --------------------------------------
# DOMAIN=lista.midominio.com
# PUBLIC_URL=https://lista.midominio.com
