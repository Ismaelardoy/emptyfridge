{
  "name": "emptyfridge",
  "version": "0.1.0",
  "private": true,
  "description": "La lista de la compra de casa, sin fricción.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "corepack pnpm --filter @emptyfridge/contracts build && corepack pnpm -r --parallel dev",
    "typecheck": "pnpm --filter @emptyfridge/contracts build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "db:generate": "pnpm --filter @emptyfridge/api db:generate",
    "db:migrate": "pnpm --filter @emptyfridge/api db:migrate",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.49.0"
  },
  "pnpm": {
    "overrides": {
      "fastify": "^5.12.8"
    }
  }
}
